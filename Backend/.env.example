PORT=5000
# Percent-encode reserved characters in the username or password.
DATABASE_URL=postgresql://your_postgres_username:your_postgres_password@localhost:5432/notes_db
# Required. Must be a strong random string of at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_random_32plus_character_secret
# Access token lifetime (short-lived; renewed via refresh token)
JWT_ACCESS_EXPIRES_IN=15m
# Refresh (session) token lifetime in days
JWT_REFRESH_EXPIRES_DAYS=7
# Allowed browser origin(s) for the web frontend. Required in production
# (the server fails fast at startup if missing/invalid). Comma-separated list.
# In production set this to your deployed frontend origin, e.g.:
#   CLIENT_URL=https://cohort-9-mern-7882-musaddif-production-d38c.up.railway.app
# Multiple origins are supported (comma-separated):
#   CLIENT_URL=https://your-frontend.up.railway.app,https://your-custom-domain.com
CLIENT_URL=http://localhost:5173
# Always "production" in deployed environments — the server then fails fast on
# misconfiguration, issues Secure-only cookies, sends HSTS, and returns generic
# error messages without leaking internal details.
NODE_ENV=development
# Number of trusted reverse-proxy hops (set to 1 when behind nginx/reverse proxy)
TRUST_PROXY=1

# Rate limiting (requests per window; optional overrides)
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_LOGIN=20
RATE_LIMIT_REGISTER=10
RATE_LIMIT_FORGOT_PASSWORD=5
RATE_LIMIT_RESET_PASSWORD=5
RATE_LIMIT_REFRESH=60
RATE_LIMIT_LOGOUT=30
RATE_LIMIT_AI=20

# PostgreSQL pool tuning (optional). Raise PG_POOL_MAX to match your Postgres
# limits; timeouts prevent slow queries from holding slots forever.
PG_POOL_MAX=20
PG_POOL_IDLE_TIMEOUT=30000
PG_CONNECT_TIMEOUT=10000
PG_STATEMENT_TIMEOUT=30000
PG_QUERY_TIMEOUT=30000
PG_APP_NAME=notes-backend

# Process model (optional). Default 1 = single process (unchanged). Each
# worker also loads its own grammar-inference worker thread, so higher values
# multiply memory: prefer multiple replicas behind a load balancer for scale.
CLUSTER_WORKERS=1
# Keep-alive timeout the HTTP server allows per connection (ms).
KEEP_ALIVE_TIMEOUT_MS=5000

# Grammar service (optional). Inference runs in a worker thread with a bounded
# queue, per-job timeout, and an LRU cache of identical inputs.
# GRAMMAR_MODEL=Xenova/t5-base-grammar-correction
# GRAMMAR_MAX_QUEUE=16
# GRAMMAR_CACHE_MAX=100
# GRAMMAR_JOB_TIMEOUT_MS=120000

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_smtp_app_password
EMAIL_FROM=your_email@gmail.com